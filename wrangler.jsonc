{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "test",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "224a71a3-b15b-4334-9bbe-d42543e97500","database_name": "test-vpn" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d86777c3e2de4ad4b2d5a30c82e2be5e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
